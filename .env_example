# MLflow endpoint reachable from Kubernetes pods
MLFLOW_TRACKING_URI=http://mlflow-host:5000

# Optional direct model URI (example: runs:/<run_id>/model)
# If MODEL_URI is set, model_service loads this URI directly.
# MODEL_URI=

# Kubernetes namespace and service naming
K8S_NAMESPACE=api-models
MODEL_SERVICE_PREFIX=model
MODEL_URL_TEMPLATE=http://{service_name}:3000

# Gateway Service port (Service port; container listens on 3000)
GATEWAY_PORT=8000

# Shared images used by scripts (build/deploy helpers)
GATEWAY_IMAGE=registry.example.com/my-project/model-gateway:latest
MODEL_SERVICE_IMAGE=registry.example.com/my-project/model-service:latest

# Registry settings (required for push/pull and model image automation)
# Use only the registry host (no UI paths).
REGISTRY_SERVER=registry.example.com
TU_ORG=my-project
REGISTRY_USERNAME=YOUR_REGISTRY_USER
REGISTRY_PASSWORD=YOUR_REGISTRY_TOKEN_OR_PASSWORD
MODEL_REGISTRY_SECRET=model-registry-creds

# Base image for model-image build jobs
MODEL_BASE_IMAGE=registry.example.com/my-project/model-service-base:py310

# Kaniko runtime settings
KANIKO_IMAGE=gcr.io/kaniko-project/executor:v1.23.2-debug
KANIKO_SKIP_TLS_VERIFY=0

# Gateway async deploy endpoint defaults
AUTO_DEPLOY_ENABLED=1
DEPLOY_BUILD_TIMEOUT_SEC=1800
DEPLOY_ROLLOUT_TIMEOUT_SEC=300
