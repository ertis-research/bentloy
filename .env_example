# Configuración de MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000

# Namespace y convenciones de despliegue en Kubernetes
K8S_NAMESPACE=ml-serving
MODEL_SERVICE_PREFIX=model

# Modelos a deployar (formato: NOMBRE:VERSION:PUERTO)
# Si VERSION=latest, busca en stage "Production"
MODELS=modelo_a:latest:3001,modelo_b:v1:3002

# Puerto del gateway
GATEWAY_PORT=8000

# Imágenes por defecto (opcionales)
GATEWAY_IMAGE=model-gateway:latest
MODEL_SERVICE_IMAGE=model-service:latest