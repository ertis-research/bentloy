# MLflow endpoint reachable from Kubernetes pods
MLFLOW_TRACKING_URI=http://mlflow.example.com:5000

# Optional direct model URI (for example: runs:/<run_id>/model)
# If MODEL_URI is set, model_service loads this URI directly.
# MODEL_URI=

# Kubernetes namespace and naming convention
K8S_NAMESPACE=api-models
MODEL_SERVICE_PREFIX=model

# Gateway service port (Service port, container still listens on 3000)
GATEWAY_PORT=8000

# Default images used by k8s/deploy_*.sh
GATEWAY_IMAGE=model-gateway:latest
MODEL_SERVICE_IMAGE=model-service:latest
BOOTSTRAP_TAG=latest

# Registry and base image settings for model-image automation phases
# REGISTRY_SERVER is required for phase scripts (no default is assumed).
# Use only the registry host (example: registry.example.com), not UI URLs like /harbor/projects.
# REGISTRY_SERVER=registry.example.com
# TU_ORG=my-registry-project-or-namespace
MODEL_REGISTRY_SECRET=model-registry-creds
# MODEL_BASE_IMAGE=registry.example.com/my-project/model-service-base:py310
# KANIKO_SKIP_TLS_VERIFY=1  # Only for self-signed registries (temporary workaround).
