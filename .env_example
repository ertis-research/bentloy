# Configuration for `python bentloy.py` (copy to .env).
# Environment variables take precedence over this file.

# --- Required -------------------------------------------------------------

# MLflow endpoint reachable from the Kubernetes pods
MLFLOW_TRACKING_URI=http://mlflow-host:5000

# Registry where images are pushed (host only, no UI paths)
REGISTRY_SERVER=registry.example.com
REGISTRY_USERNAME=YOUR_REGISTRY_USER
REGISTRY_PASSWORD=YOUR_REGISTRY_TOKEN_OR_PASSWORD

# Kubernetes namespace for the gateway and the models (default: default)
K8S_NAMESPACE=default

# --- Optional (defaults shown) --------------------------------------------

# Namespace/project/org inside the registry (Harbor project, Docker Hub user/org, GHCR owner...).
# Optional: leave empty if your registry has no namespaces; images become <REGISTRY_SERVER>/<image>.
REGISTRY_NAMESPACE=my-project

# Registry pull/push secret created by `bentloy up` (needs REGISTRY_USERNAME/PASSWORD;
# without them the secret must already exist in the namespace)
# MODEL_REGISTRY_SECRET=bentloy-registry-creds

# Set to 1 when the registry uses a self-signed certificate
# KANIKO_SKIP_TLS_VERIFY=0

# Gateway Service (container listens on 3000)
# GATEWAY_PORT=8000
# GATEWAY_REPLICAS=1
# GATEWAY_SERVICE_TYPE=LoadBalancer
# Gateway URL used by `bentloy deploy/models/...`; if empty, kubectl port-forward is used
# GATEWAY_URL=

# Image overrides. By default bentloy builds them from the repo and tags them with a
# hash of their sources (<registry>[/<namespace>]/model-gateway:<hash>,
# <registry>[/<namespace>]/model-service-base:py312-<hash>). Set these only to pin existing images.
# GATEWAY_IMAGE=
# MODEL_BASE_IMAGE=

# Model naming / routing
# MODEL_SERVICE_PREFIX=bentloy-model
# MODEL_URL_TEMPLATE=http://{service_name}:3000

# Model image builds (Kaniko) and deploy timeouts
# KANIKO_IMAGE=gcr.io/kaniko-project/executor:v1.23.2-debug
# Reuse the dependency layer between model builds (stored in <registry>[/<namespace>]/kaniko-cache)
# KANIKO_CACHE=1
# Extra pip index for model dependencies. Default: PyTorch CPU wheels (no CUDA libs,
# much smaller images). Set it empty on GPU clusters that need CUDA builds of torch.
# MODEL_PIP_EXTRA_INDEX_URL=https://download.pytorch.org/whl/cpu
# AUTO_DEPLOY_ENABLED=1
# DEPLOY_BUILD_TIMEOUT_SEC=1800
# DEPLOY_ROLLOUT_TIMEOUT_SEC=300
